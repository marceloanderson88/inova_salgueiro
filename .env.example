# URL pública do site — usada em metadados, sitemap e canonical URLs.
# Em produção, informe o domínio final (ex.: https://inovasalgueiro.com.br).
NEXT_PUBLIC_SITE_URL=https://inovasalgueiro.com.br

# ---------------------------------------------------------------------------
# Supabase (opcional)
#
# Sem estas variáveis o site funciona normalmente: as manifestações de
# interesse são validadas, recebem protocolo e ficam registradas no log do
# servidor (visível em Vercel > Deployments > Functions > Logs).
#
# Ao configurar, execute antes a migração em supabase/migrations/.
# A service role key NUNCA deve ter o prefixo NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# E-mail (opcional)
#
# Sem estas variáveis o formulário continua funcionando normalmente — apenas
# nenhum e-mail é enviado. Com elas configuradas, cada manifestação dispara:
#   1. uma confirmação com o protocolo para quem preencheu o formulário;
#   2. um aviso para a governança, com "responder para" no e-mail da pessoa.
#
# Crie a API key em https://resend.com/api-keys.
# EMAIL_REMETENTE precisa usar um domínio verificado no Resend. Para testar
# antes de verificar o domínio, use "Inova Salgueiro <onboarding@resend.dev>"
# — nesse modo o Resend só entrega para o e-mail dono da conta.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_REMETENTE="Inova Salgueiro <contato@inovasalgueiro.com.br>"
# Quem recebe o aviso de cada nova manifestação. Aceita vários endereços
# separados por vírgula — todos no mesmo "to", então dá para responder a todos.
EMAIL_NOTIFICACAO="contato@inovasalgueiro.com.br"

# Nome usado na prévia enviada por `npm run previa-email`.
PREVIA_NOME=

# Sobrescreve o endpoint do Resend. Só é útil para testes locais contra um
# servidor falso; em produção deixe em branco.
RESEND_API_URL=
